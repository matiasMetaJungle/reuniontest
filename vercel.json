{
  "headers": [
    {
      "source": "/(.*)\\.(data|wasm|js|unityweb)\\.(br|gz)",
      "headers": [
        {
          "key": "Content-Encoding",
          "value": "br"
        },
        {
          "key": "Content-Type",
          "value": "application/octet-stream"
        }
      ]
    }
  ]
}